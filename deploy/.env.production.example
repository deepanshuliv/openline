# Production env for docker-compose.prod.yml. On the VM this lives at
# /opt/apps/openline/.env (chmod 600). Never commit real values.

# Public origin of the site (CORS for the API; the web app itself calls /api same-origin).
CORS_ORIGIN=https://openline.deepanshu.live

# Postgres runs in the Compose network; generate with: openssl rand -hex 24
POSTGRES_PASSWORD=
# Days of finished-call history kept before the retention job deletes it.
CALL_RETENTION_DAYS=90

# ---- LiveKit Cloud ----
LIVEKIT_URL=wss://your-project.livekit.cloud
LIVEKIT_API_KEY=
LIVEKIT_API_SECRET=

# ---- Providers ----
ASSEMBLYAI_API_KEY=
ASSEMBLYAI_MODEL=universal-streaming-english
DEEPSEEK_API_KEY=
DEEPSEEK_MODEL=deepseek-chat
RIME_API_KEY=
RIME_MODEL=mistv3
RIME_SPEAKER=cove
PROVIDER_FALLBACK=on

# ---- Latency tuning ----
VAD_MIN_SILENCE_MS=250
ENDPOINTING_MIN_DELAY_MS=600
ENDPOINTING_MAX_DELAY_MS=1200
TURN_DETECTOR=on
PREEMPTIVE_GENERATION=on
TRANSFER_TIMEOUT_SEC=90
