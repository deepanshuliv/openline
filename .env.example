# Copy to .env and fill in. Never commit .env — it is gitignored.
# Single root .env — every app (web/api/agent/db) loads this same file via dotenv-cli.

# ---- LiveKit Cloud (https://cloud.livekit.io) — rooms + turn detector ----
LIVEKIT_URL=wss://your-project.livekit.cloud
LIVEKIT_API_KEY=
LIVEKIT_API_SECRET=
NEXT_PUBLIC_LIVEKIT_URL=wss://your-project.livekit.cloud

# ---- STT: AssemblyAI (https://www.assemblyai.com/app/api-keys) ----
ASSEMBLYAI_API_KEY=
ASSEMBLYAI_MODEL=universal-streaming-english

# ---- LLM: DeepSeek (https://platform.deepseek.com/api_keys) ----
DEEPSEEK_API_KEY=
DEEPSEEK_MODEL=deepseek-chat

# ---- TTS: Rime (https://app.rime.ai/tokens) ----
RIME_API_KEY=
# mistv3 is the low-latency model; arcana is more expressive but slower.
RIME_MODEL=mistv3
RIME_SPEAKER=cove

# ---- Fallbacks via LiveKit Inference (billed to the LiveKit project) ----
# Used only if a provider above errors or times out; "off" disables them.
PROVIDER_FALLBACK=on

# Latency tuning (see README "Latency").
VAD_MIN_SILENCE_MS=250
ENDPOINTING_MIN_DELAY_MS=600
ENDPOINTING_MAX_DELAY_MS=1200
TURN_DETECTOR=on
PREEMPTIVE_GENERATION=on
# Seconds a warm transfer waits in the staff queue before the agent takes the caller back.
TRANSFER_TIMEOUT_SEC=90

# ---- Local infra (docker compose up -d postgres redis) ----
# Change the host ports if 5432/6379 are already taken on your machine.
POSTGRES_HOST_PORT=5432
REDIS_HOST_PORT=6379
DATABASE_URL=postgresql://gideon:gideon@localhost:5432/gideon_voice
REDIS_URL=redis://localhost:6379

# ---- apps/api + apps/web ----
API_PORT=4000
CORS_ORIGIN=http://localhost:3000
NEXT_PUBLIC_API_URL=http://localhost:4000
