# Copy to .env and fill in. Never commit .env — it is gitignored.
# Single root .env — every app (web/api/agent/db) loads this same file via dotenv-cli.

# ---- LiveKit Cloud (free project at https://cloud.livekit.io) ----
LIVEKIT_URL=wss://your-project.livekit.cloud
LIVEKIT_API_KEY=
LIVEKIT_API_SECRET=
# Same URL, exposed to the browser bundle — LiveKit room URLs are not secret.
NEXT_PUBLIC_LIVEKIT_URL=wss://your-project.livekit.cloud

# ---- OpenRouter (https://openrouter.ai/keys) — model gateway for the LLM ----
OPENROUTER_API_KEY=
OPENROUTER_MODEL=openai/gpt-4o-mini
OPENROUTER_EXTRACTION_MODEL=openai/gpt-4o-mini

# ---- Deepgram (https://console.deepgram.com) — streaming STT (Nova) + TTS (Aura) ----
DEEPGRAM_API_KEY=

# ---- Postgres (docker compose up postgres — no account needed) ----
DATABASE_URL=postgresql://gideon:gideon@localhost:5432/gideon_voice

# ---- Redis (docker compose up redis — no account needed) ----
REDIS_URL=redis://localhost:6379

# ---- apps/api ----
API_PORT=4000
NEXT_PUBLIC_API_URL=http://localhost:4000

# Deliberately no NODE_ENV here — each tool (next build/dev, tsx) sets its own default,
# and forcing one value across all of them via this shared file breaks `next build`
# (it expects NODE_ENV=production during the build, not whatever dev default we'd pick).
