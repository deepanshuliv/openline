# Production image shared by every app service (api, agent, web, migrate, seed).
# docker-compose.prod.yml picks the entrypoint per service.
# Real Node is needed: Next 16 crashes under Bun's node shim (oven/bun images
# link `node` to bun). Bun is copied in for install and for api/agent.
FROM oven/bun:1.3.13 AS bun

FROM node:22.23.3-bookworm-slim AS base
RUN apt-get update && apt-get install -y --no-install-recommends openssl ca-certificates && rm -rf /var/lib/apt/lists/*
COPY --from=bun /usr/local/bin/bun /usr/local/bin/bun
RUN ln -s /usr/local/bin/bun /usr/local/bin/bunx
ENV NEXT_TELEMETRY_DISABLED=1
WORKDIR /repo

FROM base AS build
# Empty = same-origin: the browser calls /api/... on whatever host served the page,
# so a domain change needs no rebuild.
ARG NEXT_PUBLIC_API_URL=""
ENV NEXT_PUBLIC_API_URL=$NEXT_PUBLIC_API_URL

COPY . .
# postinstall runs `prisma generate`.
RUN bun install --frozen-lockfile
RUN bun run --cwd apps/api build \
 && bun run --cwd apps/agent build \
 && cd apps/web && ./node_modules/.bin/next build \
 && rm -rf .next/cache

FROM base
ENV NODE_ENV=production
COPY --from=build /repo /repo
