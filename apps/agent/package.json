{
  "name": "agent",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "dotenv -e ../../.env -- tsx watch src/entry.ts dev",
    "build": "tsc -p tsconfig.json && cp -r src/policy dist/policy",
    "start": "bun dist/entry.js start",
    "lint": "eslint . --max-warnings 0",
    "check-types": "tsc --noEmit"
  },
  "dependencies": {
    "@livekit/agents": "1.6.3",
    "@livekit/agents-plugin-deepgram": "1.6.3",
    "@livekit/agents-plugin-openai": "1.6.3",
    "@livekit/agents-plugin-silero": "1.6.3",
    "@openrouter/sdk": "^1.2.27",
    "@repo/db": "*",
    "@repo/shared": "*",
    "ioredis": "^6.0.0",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@repo/eslint-config": "*",
    "@repo/typescript-config": "*",
    "@types/node": "^22.15.3",
    "dotenv-cli": "^11.0.0",
    "tsx": "^4.23.12",
    "typescript": "5.9.2"
  }
}
